<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.angloedge-pipeline.rns</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/m4server/projects/angloedge-pipeline && /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 collect.py --rns && /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 process_rns.py && /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 process_rns.py --publish</string>
    </array>

